# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 管理员 ID（逗号分隔多个管理员）
ADMIN_IDS=5528758975

# PostgreSQL 数据库 URL（从 Railway 复制）
DATABASE_URL=

# SQLite 数据库路径（如果不使用 PostgreSQL）
DATABASE_PATH=/app/data/wolf_recs.db

# 调试模式
DEBUG=False

# 运行环境（development 或 production）
NODE_ENV=production

# Railway 公网 URL（Railway 自动设置）
# 无需手动配置，Railway 会自动注入
RAILWAY_PUBLIC_URL=